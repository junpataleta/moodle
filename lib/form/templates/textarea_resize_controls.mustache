{{!
    @template core_form/textarea_resize_controls

    Template that provides a dragging alternative for resizing text areas using buttons to increase or decrease the number of
    columns or rows in the text areas.

    Example context (json):
    {
        "textareaid": "target-textarea",
        "showresizerowscontrols": true,
        "showresizecolscontrols": true,
        "textarealabel": "Resizable text area"
    }
}}
<div class="d-flex justify-content-end w-100 mt-1">
    <div id="{{textareaid}}-resize-status" class="visually-hidden" role="status" aria-atomic="true"></div>
    {{#showresizerowscontrols}}
        <div id="{{textareaid}}-resize-rows-controls" class="btn-group" role="group">
            <button type="button" id="{{textareaid}}-increase-rows" class="btn btn-outline-secondary" data-function="resizetextarea" data-action="increase-rows" title="{{#str}}textarearesizerowsincrease, form{{/str}}" aria-controls="{{textareaid}}">
                {{#pix}}t/down, core{{/pix}}
                <span class="visually-hidden">
                    {{#textarealabel}}
                        {{#str}}elementincreaseheight, form, {{.}}{{/str}}
                    {{/textarealabel}}
                    {{^textarealabel}}
                        {{#str}}textarearesizerowsincrease, form{{/str}}
                    {{/textarealabel}}
                </span>
            </button>
            <button type="button" id="{{textareaid}}-decrease-rows" class="btn btn-outline-secondary" data-function="resizetextarea" data-action="decrease-rows" title="{{#str}}textarearesizerowsdecrease, form{{/str}}" aria-controls="{{textareaid}}">
                {{#pix}}t/up, core{{/pix}}
                <span class="visually-hidden">
                    {{#textarealabel}}
                        {{#str}}elementdecreaseheight, form, {{.}}{{/str}}
                    {{/textarealabel}}
                    {{^textarealabel}}
                        {{#str}}textarearesizerowsdecrease, form{{/str}}
                    {{/textarealabel}}
                </span>
            </button>
        </div>
    {{/showresizerowscontrols}}
    {{#showresizecolscontrols}}
        <div id="{{textareaid}}-resize-cols-controls" class="btn-group ml-1" role="group">
            <button type="button" id="{{textareaid}}-increase-cols" class="btn btn-outline-secondary" data-function="resizetextarea" data-action="increase-cols" title="{{#str}}textarearesizecolsincrease, form{{/str}}" aria-controls="{{textareaid}}">
                {{#pix}}t/right, core{{/pix}}
                <span class="visually-hidden">
                    {{#textarealabel}}
                        {{#str}}elementincreasewidth, form, {{.}}{{/str}}
                    {{/textarealabel}}
                    {{^textarealabel}}
                        {{#str}}textarearesizecolsincrease, form{{/str}}
                    {{/textarealabel}}
                </span>
            </button>
            <button type="button" id="{{textareaid}}-decrease-cols" class="btn btn-outline-secondary" data-function="resizetextarea" data-action="decrease-cols" title="{{#str}}textarearesizecolsdecrease, form{{/str}}" aria-controls="{{textareaid}}">
                {{#pix}}t/left, core{{/pix}}
                <span class="visually-hidden">
                    {{#textarealabel}}
                        {{#str}}elementdecreasewidth, form, {{.}}{{/str}}
                    {{/textarealabel}}
                    {{^textarealabel}}
                        {{#str}}textarearesizecolsdecrease, form{{/str}}
                    {{/textarealabel}}
                </span>
            </button>
        </div>
    {{/showresizecolscontrols}}
</div>
