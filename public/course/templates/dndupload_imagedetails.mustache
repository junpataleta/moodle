{{!
    @template core_course/dndupload_imagedetails

    Image details form shown by the "Add media to course page" drag-and-drop shortcut before a dropped
    image is added to a Text and media activity. Lets the author provide alternative text, mark the image
    decorative and choose its display size.

    Context variables required for this template:
    * previewurl - Object URL of the dropped image, used for the preview.
    * filename - The dropped file name.
    * width - Natural width of the image in pixels (0 when unknown, e.g. SVG).
    * height - Natural height of the image in pixels (0 when unknown, e.g. SVG).
    * hasdimensions - Whether the image has known pixel dimensions (enables the size controls).
    * maxlengthalt - Maximum number of characters allowed for the alternative text.

    Example context (json):
    {
        "previewurl": "https://example.com/image.png",
        "filename": "image.png",
        "width": 800,
        "height": 600,
        "hasdimensions": true,
        "maxlengthalt": 750
    }
}}
<div class="dndupload-imagedetails" data-region="dndupload-imagedetails">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-5">
                <div class="mb-3">
                    <h6 class="fw-bold">{{#str}} dndimagealt, core_course {{/str}}</h6>
                    <label for="dndupload_imagealt" class="form-label">{{#str}} dndimagealtdescription, core_course {{/str}}</label>
                    <textarea
                        id="dndupload_imagealt"
                        class="form-control"
                        rows="4"
                        maxlength="{{maxlengthalt}}"
                        data-region="alt"
                    ></textarea>
                    <div class="d-flex justify-content-end small text-muted mt-1">
                        <span data-region="altcount">0</span>
                        <span class="mx-1">/</span>
                        <span>{{maxlengthalt}}</span>
                    </div>
                    <div class="text-danger small d-none" data-region="altwarning" role="alert">
                        {{#str}} dndimagealtrequired, core_course {{/str}}
                    </div>
                </div>
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="dndupload_imagedecorative" data-region="presentation">
                    <label class="form-check-label" for="dndupload_imagedecorative">
                        {{#str}} dndimagedecorative, core_course {{/str}}
                    </label>
                </div>
                {{#hasdimensions}}
                    <hr>
                    <h6 class="fw-bold">{{#str}} dndimagesize, core_course {{/str}}</h6>
                    <div class="btn-group mb-2" role="group" aria-label="{{#str}} dndimagesize, core_course {{/str}}">
                        <button type="button" class="btn btn-primary" data-action="size-original" aria-pressed="true">
                            {{#str}} dndimageoriginal, core_course {{/str}}
                        </button>
                        <button type="button" class="btn btn-outline-primary" data-action="size-custom" aria-pressed="false">
                            {{#str}} dndimagecustom, core_course {{/str}}
                        </button>
                    </div>
                    <div class="d-none" data-region="customsize">
                        <div class="d-flex flex-wrap">
                            <div class="me-3 mb-2">
                                <label for="dndupload_imagewidth" class="form-label">{{#str}} dndimagewidth, core_course {{/str}}</label>
                                <div class="input-group">
                                    <input
                                        type="number"
                                        min="0"
                                        class="form-control"
                                        id="dndupload_imagewidth"
                                        data-region="width"
                                        value="{{width}}"
                                    >
                                    <span class="input-group-text">px</span>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label for="dndupload_imageheight" class="form-label">{{#str}} dndimageheight, core_course {{/str}}</label>
                                <div class="input-group">
                                    <input
                                        type="number"
                                        min="0"
                                        class="form-control"
                                        id="dndupload_imageheight"
                                        data-region="height"
                                        value="{{height}}"
                                    >
                                    <span class="input-group-text">px</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-text">{{#str}} dndimagesizehint, core_course {{/str}}</div>
                    </div>
                {{/hasdimensions}}
            </div>
            <div class="col-lg-7">
                <div class="border rounded p-2 d-flex align-items-center justify-content-center">
                    <img src="{{previewurl}}" alt="" class="img-fluid rounded" data-region="preview">
                </div>
                <div class="text-center text-muted small mt-1 text-truncate" title="{{filename}}">{{filename}}</div>
            </div>
        </div>
    </div>
</div>
